# Local Docker defaults only. Review and replace passwords before first startup.
COMPOSE_PROJECT_NAME=laundry-management

MYSQL_DATABASE=laundry_management
MYSQL_USER=laundry
MYSQL_PASSWORD=change_me_local
MYSQL_ROOT_PASSWORD=change_me_root_local
MYSQL_PORT=3306

BACKEND_PORT=8080
FRONTEND_PORT=5173
DB_CONNECTION_TIMEOUT_MS=30000

# Generate a random value with at least 32 characters. Never reuse this example in production.
APP_JWT_SECRET=replace_with_a_random_secret_of_at_least_32_characters
APP_JWT_EXPIRATION=PT1H
APP_REFRESH_TOKEN_EXPIRATION=P7D
# Set true when the application is served over HTTPS.
APP_REFRESH_TOKEN_SECURE_COOKIE=false

# Required for employee identity operations. Generate exactly 32 random bytes and Base64-encode them.
# Keep the production value in a secret manager and never rotate it without a data migration plan.
APP_EMPLOYEE_IDENTITY_KEY=

# Private employee document limits in bytes (JPEG/PNG and PDF).
APP_EMPLOYEE_DOCUMENT_IMAGE_MAX_BYTES=10485760
APP_EMPLOYEE_DOCUMENT_PDF_MAX_BYTES=20971520

# Province Open API backend proxy/cache. V2 is current; V1 supports addresses from before 07/2025.
APP_VIETNAM_LOCATION_BASE_URL=https://provinces.open-api.vn
APP_VIETNAM_LOCATION_CONNECT_TIMEOUT=PT2S
APP_VIETNAM_LOCATION_READ_TIMEOUT=PT3S
APP_VIETNAM_LOCATION_CACHE_TTL=P30D
APP_VIETNAM_LOCATION_STALE_TTL=P90D
APP_VIETNAM_LOCATION_CACHE_MAX_ENTRIES=1024

# Optional first-run bootstrap. Keep disabled in production and omit credentials unless enabled.
APP_BOOTSTRAP_ENABLED=false
APP_BOOTSTRAP_USERNAME=
APP_BOOTSTRAP_PASSWORD=
APP_BOOTSTRAP_BRANCH_CODE=MAIN
APP_BOOTSTRAP_BRANCH_NAME=Chi nhánh chính

# Optional demo/development catalog data. Never enable this in production.
# The actor must already exist; first-run local setups can reuse APP_BOOTSTRAP_USERNAME.
APP_DEMO_SEED_ENABLED=false
APP_DEMO_SEED_ACTOR_USERNAME=
APP_DEMO_SEED_BRANCH_CODE=MAIN

# docker-compose.yml intentionally pins the backend container to this profile.
SPRING_PROFILES_ACTIVE=docker
