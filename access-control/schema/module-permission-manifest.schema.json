{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://laundry.local/schemas/module-permission-manifest.schema.json",
  "title": "Laundry module permission manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["module", "permissions", "defaultRoleGrants"],
  "properties": {
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "nameVi", "nameEn", "descriptionVi", "descriptionEn", "displayOrder"],
      "properties": {
        "code": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "nameVi": { "type": "string", "minLength": 1 },
        "nameEn": { "type": "string", "minLength": 1 },
        "descriptionVi": { "type": "string", "minLength": 1 },
        "descriptionEn": { "type": "string", "minLength": 1 },
        "displayOrder": { "type": "integer", "minimum": 0 },
        "dataScopeNotes": { "type": "string" },
        "businessPolicyNotes": { "type": "string" }
      }
    },
    "permissions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "resource", "action", "nameVi", "nameEn", "descriptionVi", "descriptionEn", "riskLevel", "displayOrder"],
        "properties": {
          "code": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9]*)+$" },
          "resource": { "type": "string", "minLength": 1 },
          "action": { "type": "string", "minLength": 1 },
          "nameVi": { "type": "string", "minLength": 1 },
          "nameEn": { "type": "string", "minLength": 1 },
          "descriptionVi": { "type": "string", "minLength": 1 },
          "descriptionEn": { "type": "string", "minLength": 1 },
          "riskLevel": { "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] },
          "displayOrder": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "defaultRoleGrants": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": { "type": "string" },
        "uniqueItems": true
      }
    }
  }
}
